# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
backend/vendor/

# ─── Build output ────────────────────────────────────────────────────────────
frontend/dist/
shared/dist/
backend/public/build/
backend/public/hot/

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
auth.json

# ─── Logs & runtime files ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Caches & tooling artifacts ──────────────────────────────────────────────
.eslintcache
*.tsbuildinfo
.stylelintcache
.parcel-cache
.turbo

# ─── Test & coverage output ──────────────────────────────────────────────────
coverage/
.nyc_output/
.phpunit.result.cache
.phpunit.cache/

# ─── Laravel framework caches (regenerated) ──────────────────────────────────
backend/bootstrap/cache/*.php
backend/storage/pail/
backend/storage/*.key

# ─── Editor & IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
.fleet/
.nova/
.zed/
.cursor/
.codex/
.kilo/
.opencode/
*.swp
*.swo

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Tool state ──────────────────────────────────────────────────────────────
.codebase-memory/
.playwright-mcp/
