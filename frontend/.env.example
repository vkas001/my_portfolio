# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the Laravel backend API.
#
# Option A (LAN IP — other devices on the network can use the app):
#   VITE_API_URL=http://10.20.30.25:4000/api
#
# Option B (unset / default — goes through the Vite dev proxy):
#   VITE_API_URL=http://localhost:4000/api
#
# In production, point at the deployed API origin:
#   VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=http://10.20.30.25:8000/api
