# Base URL of the Laravel API.
#
# Same-origin deployment (nginx serves this build and proxies /api): keep "/api".
# Separate frontend/API hosts: set the full API origin at build time, e.g.
#   VITE_API_URL=https://api.your-domain.com/api
#
# The dev server proxies /api and /storage to http://127.0.0.1:8000
# (override with VITE_DEV_API_TARGET).
VITE_API_URL=/api
