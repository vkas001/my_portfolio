APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (matches the reference ibiz_backend_v2 setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

# Comma-separated allowed frontend origins (only needed when the frontend is
# served from a different origin than the API).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# GitHub stats (optional - /api/github/stats returns 404 when unset)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Contact mail. MAIL_MAILER=log only writes submissions to the log; production
# needs a real transport or the contact form never delivers email.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_FROM="Portfolio <noreply@example.com>"
CONTACT_TO=you@example.com

# Production overrides:
#   APP_ENV=production
#   APP_DEBUG=false
#   LOG_LEVEL=warning
#   APP_URL=https://your-domain
#   SCRAMBLE_DEV_TOOLS=false
#   MAIL_MAILER=smtp (+ credentials above)
#   CORS_ORIGIN=https://your-frontend-origin
SCRAMBLE_DEV_TOOLS=false
