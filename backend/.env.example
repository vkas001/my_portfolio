APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_URL=http://10.20.30.25:4000
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (matches the reference ibiz_backend_v2 setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

# CORS — frontend dev server origin
CORS_ORIGIN=http://localhost:3000,http://10.20.30.25:3000

# GitHub stats (optional — /api/github/stats returns 404 when unset)
GITHUB_USERNAME=yourhandle
GITHUB_TOKEN=

# Contact mail (optional in local dev — submissions are logged)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_FROM="Portfolio <noreply@example.com>"
CONTACT_TO=you@example.com
